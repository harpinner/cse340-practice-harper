<%- include('../../partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>
        Enter your email and password to access your account. Do not have an account? <a href="/register">Register here</a>.
    </p>

    <form method="POST" action="/login" class="login-form">
        <!-- Email field -->
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required placeholder="Please provide your email address.">
           
        </div>

        <!-- Password field -->
         <div class="form-group">
            <label for="password">Password</label>
            <input
                type="password"
                id="password"
                name="password"
                minlength="8"
                required
                pattern="(?=.*[0-9])(?=.*[!@#$%^&*]).*"
                title="At least 8 characters, include a number and a special character"
                autocomplete="current-password"
                placeholder="Must be at least 8 characters, include a number and special character"
            >
            
        </div>

        <!-- Submit button -->
         <button type="submit">Sign In or Login</button>

        <div class="form-footer">
            <p>New user? <a href="/register">Create an account</a></p>
        </div>
    </form>
</main>
<%- include('../../partials/footer') %>