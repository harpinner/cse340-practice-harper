<%- include('../partials/header') %>
<body>
    <h1>Faculty list</h1>
    <ul class="faculty-list">
      <% faculty.forEach(member => { %>
        <li class="faculty-card">
            <img class="faculty-photo" src="/images/faculty/<%= member.slug %>.jpg" alt="<%= member.name %>">
            <br>
            <a href="/faculty/<%= member.slug %>"><strong><%= member.name %></strong></a>
            <br>
            <span><strong>Department:</strong> <%= member.department %></span>
            <br>
            <span><strong>Title:</strong> <%= member.title %></span>
        </li>
      <% }); %>
    </ul>
    <br>
    <div class="navigation">
        <p><a href="/catalog">&larr; Back to Course Catalog</a></p>
    </div>
</body>
  <%- include('../partials/footer') %>