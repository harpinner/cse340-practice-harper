<%- include('../partials/header') %>
<main>
    <h1>Course Catalog</h1>
    <p>Browse our available courses and click on any course to see detailed information including available sections and instructors.</p>

    <form method="get" action="/catalog" class="catalog-filters">
        <label>Credits:
            <input type="number" name="credits" min="0" value="<%= filters ? filters.credits : '' %>">
        </label>
        <label>Professor:
            <input type="text" name="professor" value="<%= filters ? filters.professor : '' %>">
        </label>
        <button type="submit" class="btn-primary">Filter</button>
        <a href="/catalog" class="clear-link">Clear</a>
    </form>

    <div class="course-list">
        <% if (courses.length === 0) { %>
            <p><em>No courses match the filters.</em></p>
        <% } %>
        <% courses.forEach(course => { %>
            <div class="course-card">
                <h3><a href="/catalog/<%= course.slug %>"><%= course.courseCode %></a></h3>
                <p class="course-id"><%= course.courseCode %> • <%= course.creditHours %> credits</p>
                <p class="course-description"><%= course.description %></p>
            </div>
        <% }); %>
    </div>
</main>
<%- include('../partials/footer') %>